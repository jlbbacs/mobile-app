# Copy this file to .env and fill in your values.
# These are inlined into the client bundle at build time (Expo's EXPO_PUBLIC_
# convention) — do NOT put real secrets here. They only pre-fill the
# Settings screen defaults; end users can still change them at runtime.

# The /exec URL of your deployed Google Apps Script Web App.
# See docs/DEPLOYMENT.md for how to get this.
EXPO_PUBLIC_API_ENDPOINT=

# Optional: your Google Sheet URL, shown for reference in Settings.
EXPO_PUBLIC_GOOGLE_SHEET_URL=

# Optional: the Google Drive folder ID for "Personal Registrations".
EXPO_PUBLIC_DRIVE_FOLDER_ID=

# Optional shared-secret sent with every submission, checked against the
# API_TOKEN script property in apps-script/Code.gs. Leave blank to disable.
EXPO_PUBLIC_API_TOKEN=
